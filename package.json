{
  "name": "@definancy/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for the Definancy API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "conformance": "tsx conformance/runner.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.6.1",
    "tsup": "^8.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/definancy/ts-definancy-sdk.git"
  }
}
